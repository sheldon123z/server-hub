# ServerHub 环境变量配置模板
# 复制此文件为 .env 并填入真实值
# 注意: .env 已在 .gitignore 中，不会被提交

# ─── 应用配置 ───
# SERVERHUB_SECRET_KEY=          # 留空则自动生成并保存到 data/serverhub-secret.key
# SERVERHUB_ADMIN_USERNAME=admin
# SERVERHUB_ADMIN_PASSWORD=      # 留空则自动生成并保存到 data/bootstrap-admin-password.txt

# ─── Cookie 安全 ───
# SERVERHUB_COOKIE_SECURE=always   # always | auto | never
# SERVERHUB_COOKIE_SAMESITE=lax    # lax | strict | none

# ─── 监控 ───
# SERVERHUB_GPU_METRICS_TTL_SECONDS=20
# SERVERHUB_TOP_PROCESSES_CACHE_SECONDS=10

# ─── AI Agent ───
# SERVERHUB_AGENT_MODEL=openrouter:deepseek/deepseek-chat
# SERVERHUB_PATROL_MODEL=openrouter:deepseek/deepseek-chat

# ─── LLM 服务商 API Key (按需配置) ───
# OPENROUTER_API_KEY=sk-or-xxx
# VOLCENGINE_API_KEY=
# ZHIPU_API_KEY=
# MOONSHOT_API_KEY=
# MINIMAX_API_KEY=
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=sk-xxx
# TAVILY_API_KEY=tvly-xxx

# ─── RAG 知识库 ───
# SERVERHUB_RAG_EMBEDDING_MODEL=bge-m3
# SERVERHUB_RAG_OLLAMA_URL=http://localhost:11434
# SERVERHUB_RAG_CHUNK_SIZE=800
# SERVERHUB_RAG_CHUNK_OVERLAP=100
# SERVERHUB_RAG_TOP_K=5

# ─── 开发模式 ───
# SERVERHUB_DEV=1                # 启用 CORS (Vite dev server)
